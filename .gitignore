# region gitignore-sync
# stacks: core, agents, git, node, dotenv, vscode, intellij, macos, windows, linux
# ─────────────────────────────────────────

# region core@v1
.DS_Store
# endregion

# region agents@v1
.claude/settings.local.json
.claude/worktrees/
# endregion

# region git@v1
*.orig
*.rej
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*
*_BACKUP_*.txt
*_BASE_*.txt
*_LOCAL_*.txt
*_REMOTE_*.txt
# endregion

# region node@v1
node_modules
dist
coverage
/logs
*.log
*.tsbuildinfo
.eslintcache
.npm
*.tgz
# endregion

# region dotenv@v1
.env
.env.*
!.env.example
!.env.*.example
!.env.testing
# endregion

# region vscode@v1
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/mcp.json
# endregion

# region intellij@v1
.idea/*
# endregion

# region macos@v1
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
*.icloud
# endregion

# region windows@v1
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk
# endregion

# region linux@v1
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*
# endregion

# endregion

build
out

# handover brief for the initial build — delete once implemented, never commit
temp_ai.md

# Region-specific and reproducible from the GPX via `pnpm fetch:geodata`.
# Committing them would ship one area's tiles to everyone who clones.
data/dem
data/geo

# Your own tracks and their geodata. Point HIKE_DATA_DIR at this to render them.
data.local
